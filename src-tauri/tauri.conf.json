{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QuestPlanner",
  "version": "0.1.17",
  "identifier": "fr.moufle.questplanner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5174",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "QuestPlanner",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": ["resources/dofus-companion-sync.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDRDQwRTRDMURENTM4QTcKUldTbk9OVWRUQTdVSEh3cXNpRlBWMmk3OVRDZG5XZjFkd0tqSjJYWTBVbmJhWUQ0VUlpaFhiUm4K",
      "endpoints": [
        "https://github.com/jdtaccounts-create/QuestPlanner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet",
        "installerArgs": ["/currentuser"]
      }
    }
  }
}
